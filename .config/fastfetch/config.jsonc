// Edit this layout; scripts/theme.lua generates config.jsonc from it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "#b4befe"
    },
    "padding": {
      "top": 1,
      "right": 2,
      "bottom": 1
    }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "#cba6f7",
      "title": "#cba6f7",
      "output": "#cdd6f4",
      "separator": "#a6adc8"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "󰣇  OS" },
    { "type": "kernel", "key": "󰌽  Kernel" },
    { "type": "wm", "key": "  WM" },
    { "type": "terminal", "key": "  Terminal" },
    "break",
    { "type": "cpu", "key": "󰻠  CPU", "keyColor": "#b4befe" },
    { "type": "memory", "key": "󰍛  Memory", "format": "{used} / {total}", "keyColor": "#b4befe" },
    { "type": "uptime", "key": "󰅐  Uptime", "keyColor": "#a6e3a1" },
    { "type": "packages", "key": "󰏖  Packages", "combined": true, "keyColor": "#a6e3a1" },
    "break",
    {
      "type": "custom",
      "format": "{##11111b}██{##181825}██{##1e1e2e}██{##313244}██{##45475a}██{##585b70}██{##a6adc8}██{##cdd6f4}██"
    },
    {
      "type": "custom",
      "format": "{##f5e0dc}██{##f2cdcd}██{##f5c2e7}██{##cba6f7}██{##f38ba8}██{##eba0ac}██{##fab387}██{##f9e2af}██{##a6e3a1}██{##94e2d5}██{##89dceb}██{##74c7ec}██{##89b4fa}██{##b4befe}██"
    },
    "break"
  ]
}
