// Edit this layout; scripts/theme.lua generates config.jsonc from it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "__FASTFETCH_ACCENT_ALT__"
    },
    "padding": {
      "top": 1,
      "right": 2,
      "bottom": 1
    }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "__FASTFETCH_ACCENT__",
      "title": "__FASTFETCH_ACCENT__",
      "output": "__FASTFETCH_TEXT__",
      "separator": "__FASTFETCH_MUTED__"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "󰣇  OS" },
    { "type": "kernel", "key": "󰌽  Kernel" },
    { "type": "wm", "key": "  WM" },
    { "type": "terminal", "key": "  Terminal" },
    "break",
    { "type": "cpu", "key": "󰻠  CPU", "keyColor": "__FASTFETCH_ACCENT_ALT__" },
    { "type": "memory", "key": "󰍛  Memory", "format": "{used} / {total}", "keyColor": "__FASTFETCH_ACCENT_ALT__" },
    { "type": "uptime", "key": "󰅐  Uptime", "keyColor": "__FASTFETCH_SUCCESS__" },
    { "type": "packages", "key": "󰏖  Packages", "combined": true, "keyColor": "__FASTFETCH_SUCCESS__" },
    "break",
    {
      "type": "custom",
      "format": "__FASTFETCH_PALETTE_TOP__"
    },
    {
      "type": "custom",
      "format": "__FASTFETCH_PALETTE_BOTTOM__"
    },
    "break"
  ]
}
